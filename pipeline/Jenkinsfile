// pipeline/Jenkinsfile — Multi-Platform Linux Build & Packaging Pipeline for ck-uc-discussions
// Integrates with Cloudhome Jenkins Kubernetes agent cloud on altos-worker-01

pipeline {
    agent {
        label 'jenkins-agent-rust'
    }

    parameters {
        string(name: 'PACKAGE_VERSION', defaultValue: '0.1.2', description: 'Version to package and tag')
        string(name: 'ARCUS_SEQUENCE', defaultValue: '4', description: 'Monotonic sequence allocated from Arcus catalog')
        booleanParam(name: 'PACKAGE_DISTRO', defaultValue: true, description: 'Attempt .deb and .rpm generation if tools present')
        booleanParam(name: 'RUN_ELF_AUDIT', defaultValue: true, description: 'Enforce ELF interpreter and glibc symbol inspection')
    }

    environment {
        PACKAGE_VERSION = "${params.PACKAGE_VERSION}"
        ARCUS_SEQUENCE = "${params.ARCUS_SEQUENCE}"
        PACKAGE_DISTRO = "${params.PACKAGE_DISTRO}"
        RUN_ELF_AUDIT = "${params.RUN_ELF_AUDIT}"
        CARGO_TERM_COLOR = 'always'
        RUSTFLAGS = '-D warnings'
        SCCACHE_DIR = '/srv/sccache'
        RUSTC_WRAPPER = 'sccache'
    }

    stages {
        stage('Initialize & Toolchain Audit') {
            steps {
                sh '''
                    set -eu
                    echo "==> Auditing Jenkins Agent Toolchain Environment..."
                    echo "Current user: $(id -u):$(id -g) ($(whoami 2>/dev/null || echo 'unmapped'))"
                    echo "Working directory: $(pwd)"

                    rustc --version
                    cargo --version
                    zig version || true
                    cargo zigbuild --version || true
                    sccache --version || true

                    # Ensure clean output directories using POSIX syntax (no bash brace expansion)
                    mkdir -p artifacts/bin
                    mkdir -p artifacts/packages
                    mkdir -p artifacts/archives
                    mkdir -p "dist/${ARCUS_SEQUENCE}/uc-discussions/${PACKAGE_VERSION}"
                '''
            }
        }

        stage('Compile Linux 4-Target Matrix') {
            parallel {
                stage('Linux x86_64 Static (musl)') {
                    steps {
                        sh '''
                            set -eu
                            echo "==> Compiling x86_64-unknown-linux-musl (fully static)..."
                            cargo zigbuild --release --locked -p uc-discussions --target x86_64-unknown-linux-musl
                            
                            SRC="target/x86_64-unknown-linux-musl/release/ck-uc-discussions"
                            DST="artifacts/bin/ck-uc-discussions-x86_64-musl"
                            cp "$SRC" "$DST"

                            if [ "$RUN_ELF_AUDIT" = "true" ]; then
                                echo "==> Auditing x86_64 musl ELF binary..."
                                file "$DST"
                                if command -v readelf >/dev/null 2>&1; then
                                    # Verify no dynamic section in static musl binary
                                    if readelf -d "$DST" 2>&1 | grep -q 'DYNAMIC'; then
                                        echo "ERROR: x86_64-unknown-linux-musl contains dynamic section!" >&2
                                        exit 1
                                    fi
                                    echo "  [PASS] Clean static binary verified."
                                fi
                            fi

                            # Package portable static tarballs
                            tar -C target/x86_64-unknown-linux-musl/release -czvf \
                                "artifacts/archives/ck-uc-discussions-${PACKAGE_VERSION}-linux-x86_64-musl.tar.gz" ck-uc-discussions
                        '''
                    }
                }

                stage('Linux x86_64 Dynamic (glibc 2.31 LTS)') {
                    steps {
                        sh '''
                            set -eu
                            echo "==> Compiling x86_64-unknown-linux-gnu.2.31 (glibc LTS baseline)..."
                            cargo zigbuild --release --locked -p uc-discussions --target x86_64-unknown-linux-gnu.2.31
                            
                            SRC="target/x86_64-unknown-linux-gnu/release/ck-uc-discussions"
                            DST="artifacts/bin/ck-uc-discussions-x86_64-linux-gnu"
                            cp "$SRC" "$DST"

                            if [ "$RUN_ELF_AUDIT" = "true" ]; then
                                echo "==> Auditing x86_64 glibc ELF binary..."
                                file "$DST"
                                if command -v readelf >/dev/null 2>&1; then
                                    echo "  Dynamic dependencies:"
                                    readelf -d "$DST" | grep NEEDED || true
                                    echo "  Checking glibc symbol version ceilings:"
                                    # Fail if any symbol requires GLIBC_2.32 or newer
                                    if readelf -sV "$DST" 2>&1 | grep -E 'GLIBC_2\.(3[2-9]|[4-9][0-9])' ; then
                                        echo "ERROR: Binary leaked symbols exceeding GLIBC_2.31 ceiling!" >&2
                                        exit 1
                                    fi
                                    echo "  [PASS] Verified glibc <= 2.31 compatibility."
                                fi
                            fi

                            # Package portable glibc tarball
                            tar -C target/x86_64-unknown-linux-gnu/release -czvf \
                                "artifacts/archives/ck-uc-discussions-${PACKAGE_VERSION}-linux-x86_64-gnu.tar.gz" ck-uc-discussions

                            # Attempt distro packaging if tools installed in image
                            if [ "$PACKAGE_DISTRO" = "true" ]; then
                                if command -v cargo-deb >/dev/null 2>&1; then
                                    echo "==> Generating .deb package..."
                                    cargo deb -p uc-discussions --target x86_64-unknown-linux-gnu -o artifacts/packages/ || true
                                fi
                                if command -v cargo-generate-rpm >/dev/null 2>&1; then
                                    echo "==> Generating .rpm package..."
                                    cargo generate-rpm -p uc-discussions --target x86_64-unknown-linux-gnu -o artifacts/packages/ || true
                                fi
                            fi
                        '''
                    }
                }

                stage('Linux aarch64 Static (musl)') {
                    steps {
                        sh '''
                            set -eu
                            echo "==> Compiling aarch64-unknown-linux-musl (fully static)..."
                            cargo zigbuild --release --locked -p uc-discussions --target aarch64-unknown-linux-musl
                            
                            SRC="target/aarch64-unknown-linux-musl/release/ck-uc-discussions"
                            DST="artifacts/bin/ck-uc-discussions-aarch64-musl"
                            cp "$SRC" "$DST"

                            if [ "$RUN_ELF_AUDIT" = "true" ]; then
                                echo "==> Auditing aarch64 musl ELF binary..."
                                file "$DST"
                            fi

                            tar -C target/aarch64-unknown-linux-musl/release -czvf \
                                "artifacts/archives/ck-uc-discussions-${PACKAGE_VERSION}-linux-aarch64-musl.tar.gz" ck-uc-discussions
                        '''
                    }
                }

                stage('Linux aarch64 Dynamic (glibc 2.31 LTS)') {
                    steps {
                        sh '''
                            set -eu
                            echo "==> Compiling aarch64-unknown-linux-gnu.2.31 (glibc LTS baseline)..."
                            cargo zigbuild --release --locked -p uc-discussions --target aarch64-unknown-linux-gnu.2.31
                            
                            SRC="target/aarch64-unknown-linux-gnu/release/ck-uc-discussions"
                            DST="artifacts/bin/ck-uc-discussions-aarch64-linux-gnu"
                            cp "$SRC" "$DST"

                            if [ "$RUN_ELF_AUDIT" = "true" ]; then
                                echo "==> Auditing aarch64 glibc ELF binary..."
                                file "$DST"
                                if command -v readelf >/dev/null 2>&1; then
                                    echo "  Dynamic dependencies:"
                                    readelf -d "$DST" | grep NEEDED || true
                                fi
                            fi

                            tar -C target/aarch64-unknown-linux-gnu/release -czvf \
                                "artifacts/archives/ck-uc-discussions-${PACKAGE_VERSION}-linux-aarch64-gnu.tar.gz" ck-uc-discussions

                            if [ "$PACKAGE_DISTRO" = "true" ]; then
                                if command -v cargo-deb >/dev/null 2>&1; then
                                    cargo deb -p uc-discussions --target aarch64-unknown-linux-gnu -o artifacts/packages/ || true
                                fi
                            fi
                        '''
                    }
                }
            }
        }

        stage('Assemble Arcus Sequence Envelope') {
            steps {
                sh '''
                    set -eu
                    TARGET_DIR="dist/${ARCUS_SEQUENCE}/uc-discussions/${PACKAGE_VERSION}"
                    echo "==> Assembling Arcus release payload at ${TARGET_DIR}..."
                    mkdir -p "${TARGET_DIR}"

                    # Copy binaries and archives into sequence staging
                    cp artifacts/bin/* "${TARGET_DIR}/"
                    if ls artifacts/archives/* >/dev/null 2>&1; then
                        cp artifacts/archives/* "${TARGET_DIR}/"
                    fi
                    if ls artifacts/packages/* >/dev/null 2>&1; then
                        cp artifacts/packages/* "${TARGET_DIR}/" || true
                    fi

                    # Generate canonical assets.sha256 manifest
                    (cd "${TARGET_DIR}" && sha256sum * > assets.sha256 2>/dev/null || shasum -a 256 * > assets.sha256)

                    echo "==> Arcus Sequence ${ARCUS_SEQUENCE} staging manifest:"
                    cat "${TARGET_DIR}/assets.sha256"
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'artifacts/**/*', fingerprint: true, allowEmptyArchive: false
        }
        success {
            echo "SUCCESS: Bounded 4-target Linux matrix compiled, audited, and staged for Sequence ${params.ARCUS_SEQUENCE}."
        }
        failure {
            echo "FAILURE: Linux compilation or ELF audit failed. Check stage logs."
        }
    }
}
